{
  "name": "@archboard/elk-rs",
  "version": "0.11.1",
  "description": "ELK layout engine in Rust — elkjs-compatible API with WASM and native Node.js addon (fork of openedges/elk-rs)",
  "license": "EPL-2.0",
  "main": "js/index.js",
  "browser": "js/index.browser.js",
  "types": "typings/elk-api.d.ts",
  "exports": {
    ".": {
      "types": "./typings/elk-api.d.ts",
      "browser": "./js/index.browser.js",
      "default": "./js/index.js"
    },
    "./js/elk-api.js": {
      "types": "./typings/elk-api.d.ts",
      "default": "./js/elk-api.js"
    },
    "./js/elk-worker.js": {
      "types": "./typings/elk-worker.d.ts",
      "default": "./js/elk-worker.js"
    },
    "./worker.browser": {
      "types": "./typings/worker.browser.d.ts",
      "default": "./js/worker.browser.mjs"
    },
    "./wasm-url": {
      "types": "./typings/wasm-url.d.ts",
      "default": "./js/wasm-url.mjs"
    },
    "./wasm": {
      "types": "./dist/wasm/org_eclipse_elk_wasm.d.ts",
      "default": "./dist/wasm/org_eclipse_elk_wasm.js"
    },
    "./wasm/org_eclipse_elk_wasm_bg.wasm": "./dist/wasm/org_eclipse_elk_wasm_bg.wasm",
    "./typings/*": "./typings/*",
    "./package.json": "./package.json"
  },
  "files": [
    "js/",
    "dist/wasm/",
    "typings/",
    "LICENSE.md",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:parity": "node test/parity/run.mjs",
    "bench": "node bench/bench.mjs --mode synthetic",
    "bench:models": "node bench/bench.mjs --mode models",
    "bench:all": "node bench/bench.mjs --mode models --limit 0",
    "npm:stage:platform": "bun scripts/stage-platform-package.ts",
    "npm:stage:root": "bun scripts/stage-root-package.ts",
    "npm:publish": "bun scripts/publish-npm.ts",
    "npm:publish:dry-run": "bun scripts/publish-npm.ts --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miklschmidt/elk-rs.git",
    "directory": "plugins/org.eclipse.elk.js"
  },
  "homepage": "https://github.com/miklschmidt/elk-rs/tree/archboard/plugins/org.eclipse.elk.js#readme",
  "bugs": "https://github.com/miklschmidt/elk-rs/issues",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "elkjs": "^0.11.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@archboard/elk-rs-darwin-arm64": "0.11.1",
    "@archboard/elk-rs-darwin-x64": "0.11.1",
    "@archboard/elk-rs-linux-x64-gnu": "0.11.1",
    "@archboard/elk-rs-linux-x64-musl": "0.11.1",
    "@archboard/elk-rs-linux-arm64-gnu": "0.11.1",
    "@archboard/elk-rs-win32-x64-msvc": "0.11.1"
  },
  "keywords": [
    "elk",
    "layout",
    "graph",
    "wasm",
    "napi",
    "rust"
  ]
}
